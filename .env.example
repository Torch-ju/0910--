# Server-only configuration. Never commit secrets.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Long structured drafts can take more than one minute.
LLM_TIMEOUT_MS=180000

# Optional, no default request-count cap. Includes failed and repair attempts.
# LLM_MAX_REQUESTS=100
# NARRATIVE_CONTEXT_CHARS=60000
# Optional prices in one consistent currency per million tokens.
# LLM_INPUT_PRICE_PER_MILLION=
# LLM_OUTPUT_PRICE_PER_MILLION=
# STORY_DATA_DIR=/absolute/path/to/stories
# MODEL_LEDGER_PATH=/absolute/path/to/model-requests.json
