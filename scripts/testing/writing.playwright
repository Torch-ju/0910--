// testFixture is supplied by the portable runner; use an isolated localhost port only.
await page.goto(testBase);
// Reproduce the successful-world / blocked-NPC state without paid calls.
const blockedFixture = JSON.parse(JSON.stringify(testFixture));
blockedFixture.characters.characters = [];
blockedFixture.characters.relationships = [];
blockedFixture.world.open_questions = [{ question_id:'origin', question:'主角从哪里出发？', blocking:true, importance:'high', status:'open', answer:null }];
blockedFixture.recognition = null;
await page.evaluate(snapshot => {
  localStorage.removeItem('shuzhongren.active-story');
  localStorage.setItem('shuzhongren.workspace.v1', JSON.stringify({version:1,current:snapshot,previous:null,candidate:null,pending:null,saved_at:new Date().toISOString()}));
}, blockedFixture);
await page.reload();
await page.getByRole('button',{name:'NPC画像',exact:true}).click();
await expect(page.getByRole('button',{name:'生成 NPC 画像',exact:true})).toBeEnabled();
await page.getByLabel('主角从哪里出发？',{exact:true}).fill('洛阳');
await page.getByRole('button',{name:'保存回答',exact:true}).click();
await expect(page.getByRole('button',{name:'生成 NPC 画像',exact:true})).toBeEnabled();
const beforeNpcClick = await (await context.request.get(testModel + '/metrics')).json();
assert.equal(beforeNpcClick.calls,0,'answering questions must not invoke the model');

await page.evaluate(snapshot => {
  localStorage.removeItem('shuzhongren.active-story');
  localStorage.setItem('shuzhongren.workspace.v1', JSON.stringify({ version:1, current:snapshot, previous:null, candidate:null, pending:null, saved_at:new Date().toISOString() }));
}, testFixture);
await page.reload();
await page.getByRole('button', {name:'开始写作', exact:true}).click();
await expect(page.getByRole('heading',{name:'雨夜来信',exact:true})).toBeVisible();
await expect(page.getByRole('article',{name:'正在生成的正文'})).toBeVisible({timeout:15000});
await expect(page.locator('.wa-prose article:not([aria-label])')).toHaveCount(1,{timeout:15000});
await expect(page.getByText('本轮已完成',{exact:true})).toBeVisible({timeout:15000});
assert.equal((await (await context.request.get(testModel + '/metrics')).json()).calls,3,'opening must use prose, memory and summary only');
await context.request.post(testModel + '/control', {data:{delay:100}});
await page.getByLabel('续写要求（可留空）').fill('');
await page.getByRole('button',{name:'推进故事',exact:true}).click();
await page.getByLabel('续写要求（可留空）').fill('正在准备下一轮的草稿。');
await expect(page.getByText('本轮已完成',{exact:true})).toBeVisible({timeout:15000});
await expect(page.locator('.wa-prose article:not([aria-label])')).toHaveCount(2);
await expect(page.getByLabel('续写要求（可留空）')).toHaveValue('正在准备下一轮的草稿。');
const before = await (await context.request.get(testModel + '/metrics')).json();
await page.reload();
await expect(page.locator('.wa-prose article:not([aria-label])')).toHaveCount(2);
const after = await (await context.request.get(testModel + '/metrics')).json();
assert.equal(before.calls, after.calls, 'refresh must not generate');
await context.request.post(testModel + '/control', {data:{fail:'summary',failCount:3}});
await page.getByLabel('续写要求（可留空）').fill('我询问信件的来历。');
await page.getByRole('button',{name:'推进故事',exact:true}).click();
await expect(page.getByRole('button',{name:'恢复未完成轮次（可能计费）',exact:true})).toBeEnabled({timeout:15000});
await expect(page.locator('.wa-prose article:not([aria-label])')).toHaveCount(2);
await page.reload();
await expect(page.getByRole('button',{name:'恢复未完成轮次（可能计费）',exact:true})).toBeEnabled();
await expect(page.getByRole('article',{name:'正在生成的正文'})).toBeVisible();
const countBeforeRetry = (await (await context.request.get(testModel + '/metrics')).json()).calls;
await page.getByRole('button',{name:'恢复未完成轮次（可能计费）',exact:true}).click();
await expect(page.locator('.wa-prose article:not([aria-label])')).toHaveCount(3,{timeout:15000});
await expect(page.getByRole('article',{name:'正在生成的正文'})).toHaveCount(0);
const countAfterRetry = (await (await context.request.get(testModel + '/metrics')).json()).calls;
assert.equal(countAfterRetry - countBeforeRetry, 1, 'resume must only regenerate summary');
await page.getByRole('button',{name:'章节与伏笔',exact:true}).click();
await page.getByRole('button',{name:'结束当前章（不生成新剧情）',exact:true}).click();
await expect(page.getByText('第 1 章 · 3 个片段',{exact:true})).toBeVisible();
await page.evaluate(() => { const original = URL.createObjectURL; globalThis.__exportedText = null; URL.createObjectURL = function(blob) { blob.text().then(text => { globalThis.__exportedText = text; }); return original.call(URL, blob); }; });
await page.getByRole('button',{name:'导出全文',exact:true}).click();
await page.waitForFunction(() => typeof globalThis.__exportedText === 'string');
assert((await page.evaluate(() => globalThis.__exportedText)).includes('雨敲着窗。'));
await page.getByRole('button',{name:'人物与记忆',exact:true}).click();
await expect(page.getByText('沈砚 · 独立人物',{exact:true})).toBeVisible();
await page.getByRole('button',{name:'我的作品',exact:true}).click();
await expect(page.getByRole('heading',{name:'雨夜来信',exact:true})).toBeVisible();
await page.getByRole('button',{name:'打开作品',exact:true}).click();
await context.request.post(testModel + '/control',{data:{dialogue:true}});
await page.getByLabel('续写要求（可留空）').fill('推进到沈砚与林青的对话。');
await page.getByRole('button',{name:'推进故事',exact:true}).click();
await expect(page.getByRole('dialog',{name:'与沈砚对话'})).toBeVisible({timeout:15000});
await expect(page.getByText('正文已暂停 · 你扮演 林青',{exact:true})).toBeVisible();
const dialogueCalls=(await (await context.request.get(testModel+'/metrics')).json()).calls;
assert.equal(dialogueCalls,countAfterRetry+1,'dialogue must open before memory and summary calls');
await expect(page.getByRole('button',{name:'发送给NPC',exact:true})).toBeDisabled();
await page.getByLabel('你对NPC的回应').fill('我先看信封，不打开信。');
await page.reload();
await expect(page.getByRole('dialog',{name:'与沈砚对话'})).toBeVisible();
await expect(page.getByLabel('你对NPC的回应')).toHaveValue('我先看信封，不打开信。');
assert.equal((await (await context.request.get(testModel+'/metrics')).json()).calls,dialogueCalls,'dialogue refresh must not generate');
await page.getByRole('button',{name:'发送给NPC',exact:true}).click();
await expect(page.locator('.wa-chat-log article')).toHaveCount(3,{timeout:15000});
await expect(page.getByLabel('你对NPC的回应')).toHaveValue('');
assert.equal((await (await context.request.get(testModel+'/metrics')).json()).calls,dialogueCalls+1,'reply invokes NPC only');
await page.getByLabel('你对NPC的回应').fill('这封信从哪里来的？');
await page.getByRole('button',{name:'发送给NPC',exact:true}).click();
await expect(page.locator('.wa-chat-log article')).toHaveCount(5,{timeout:15000});
await expect(page.getByRole('button',{name:'结束对话并继续正文',exact:true})).toBeEnabled();
await page.keyboard.press('Escape');
await expect(page.getByRole('dialog')).toHaveCount(0);
await page.getByRole('button',{name:'打开NPC对话窗口',exact:true}).click();
await expect(page.locator('.wa-chat-log article')).toHaveCount(5);
assert.equal((await (await context.request.get(testModel+'/metrics')).json()).calls,dialogueCalls+2,'closing a window does not resume prose');
await page.getByRole('button',{name:'结束对话并继续正文',exact:true}).click();
await expect(page.locator('.wa-prose article:not([aria-label])')).toHaveCount(4,{timeout:15000});
await expect(page.getByRole('dialog',{name:'与沈砚对话'})).toBeVisible({timeout:15000});
await expect(page.locator('.wa-chat-log article')).toHaveCount(1);
assert.equal((await (await context.request.get(testModel+'/metrics')).json()).calls,dialogueCalls+5,'finish performs memory, summary and next prose automatically');
assert((await page.locator('.wa-prose article:not([aria-label])').last().textContent()).includes('我先看信封，不打开信。'));
await expect(page.getByRole('button',{name:'结束对话并继续正文',exact:true})).toBeEnabled();
await page.getByRole('button',{name:'结束对话并继续正文',exact:true}).click();
await expect(page.locator('.wa-prose article:not([aria-label])')).toHaveCount(5,{timeout:15000});
await expect(page.getByRole('dialog',{name:'与沈砚对话'})).toBeVisible({timeout:15000});
const widths = [375,768,1280,1440];
for (const width of widths) {
  await page.setViewportSize({width,height:900});
  const sizes = await page.evaluate(()=>({document:document.documentElement.scrollWidth,viewport:window.innerWidth}));
  assert(sizes.document <= sizes.viewport, 'horizontal overflow at '+width);
}
await page.emulateMedia({reducedMotion:'reduce'});
await page.setViewportSize({width:375,height:812});
const outcome = {passed:['initialize','narrative','preserve-next-draft','refresh-no-call','summary-failure','resume-one-call','chapter','export','memory','library','responsive','dialogue-pause','dialogue-refresh','dialogue-response','multi-round-npc-only','automatic-repeat-dialogue'],calls:(await (await context.request.get(testModel+'/metrics')).json()).calls,storyId:testFixture.world.story_id};

await page.close();
return outcome;
