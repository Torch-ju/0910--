  await page.getByRole("textbox",{name:"故事名称",exact:true}).fill("雪落青崖 · 浏览器验证");
  await page.getByRole("textbox",{name:"故事名称",exact:true}).press("Tab");
  await page.waitForFunction(()=>JSON.parse(localStorage.getItem("shuzhongren.workspace.v1")).current.world.title.value==="雪落青崖 · 浏览器验证");
  await page.getByRole("button",{name:"锁定：故事名称",exact:true}).click();
  if(await page.getByRole("textbox",{name:"故事名称",exact:true}).isEditable())throw new Error("Locked title is editable");
  await page.getByRole("button",{name:"解除锁定：故事名称",exact:true}).click();
