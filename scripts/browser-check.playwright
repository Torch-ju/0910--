  const current={snapshot_version:1,preset_id:"eastern_wuxia",snapshot_revision:1,world:fixtures.world,characters:fixtures.characters,messages:[{id:"message_synthetic",role:"system",content:"本会话使用合成数据验证浏览器交互，未调用模型。",created_at:new Date().toISOString()}],input:"合成浏览器验收：师徒收到旧信。",recognition:null,timeline_suggestions:[],operations:[],updated_at:new Date().toISOString()};
  await page.addInitScript(()=>{window.__storyConfirmations=[];window.confirm=(message)=>{window.__storyConfirmations.push(message);return true;};});
