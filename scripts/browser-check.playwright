  await page.getByRole("textbox",{name:"姓名",exact:true}).fill("陆川");
  await page.getByRole("textbox",{name:"姓名",exact:true}).press("Tab");
  await page.waitForFunction(()=>JSON.parse(localStorage.getItem("shuzhongren.workspace.v1")).current.characters.characters.some(c=>c.name.value==="陆川"));
  await page.getByRole("button",{name:"删除陆川",exact:true}).click();
  await page.waitForFunction(()=>JSON.parse(localStorage.getItem("shuzhongren.workspace.v1")).current.characters.characters.length===2);
  await page.getByRole("combobox",{name:"选择被合并人物"}).selectOption("npc_student");
  await page.getByRole("combobox",{name:"选择合并目标人物"}).selectOption("npc_master");
  await page.getByRole("button",{name:"合并选择",exact:true}).click();
  await page.waitForFunction(()=>JSON.parse(localStorage.getItem("shuzhongren.workspace.v1")).current.characters.characters.length===1);
  await page.getByRole("button",{name:"保存",exact:true}).click();
  await page.reload();
  await page.getByRole("button",{name:"NPC画像",exact:true}).click();
  await page.waitForFunction(()=>JSON.parse(localStorage.getItem("shuzhongren.workspace.v1")).current.characters.characters.length===1);
  const state=await page.evaluate(()=>JSON.parse(localStorage.getItem("shuzhongren.workspace.v1")).current);
  if(state.world.title.value!=="雪落青崖 · 浏览器验证"||state.world.genre.value.join(",")!=="武侠,悬疑")throw new Error("Restore lost edited values");
  return {source:"synthetic",checks:["field editing","array separators","lock/unlock","add/rename/delete NPC","merge references","save/reload"],revision:state.snapshot_revision,npcCount:state.characters.characters.length};
