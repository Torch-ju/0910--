# Copy this file to 测试/.env, then fill the key locally and restart.
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_ATTEMPTS=2
MAX_OUTPUT_TOKENS=2400
STORY_OUTPUT_TOKENS=6000
CONTEXT_TOKEN_BUDGET=24000
# Cumulative real-model request cap for this database, including retries.
MODEL_CALL_BUDGET=100
ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
# Conservative per-request context byte ceiling; completed text remains on disk.
NOVEL_CONTEXT_BYTES=180000
