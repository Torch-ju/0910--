# Copy to .env in the repository root. Do not commit real secrets.
MODEL_PROVIDER=mock
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_ATTEMPTS=2
MAX_OUTPUT_TOKENS=2400
CONTEXT_TOKEN_BUDGET=12000
# Required positive call limit for real mode. No paid calls in mock mode.
MODEL_CALL_BUDGET=0
# Default: data/story.db in the repository root. Override with an absolute SQLite URL if needed.
# DATABASE_URL=sqlite:////absolute/path/story.db
ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
# Per model response, not a whole-novel word limit.
STORY_OUTPUT_TOKENS=6000
NOVEL_CONTEXT_BYTES=180000
